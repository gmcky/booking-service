{
  "name": "booking",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:full": "pnpm infra:up && pnpm dev",
    "start": "node dist/server.js",
    "build": "tsc --noEmit false",
    "typecheck": "tsc --noEmit",
    "workers": "concurrently --raw \"tsx --env-file=.env src/workers/image.worker.ts\" \"tsx --env-file=.env src/workers/email.worker.ts\" \"tsx --env-file=.env src/workers/cleanup.worker.ts\" \"tsx --env-file=.env src/workers/payout.worker.ts\"",
    "worker:image": "tsx --env-file=.env src/workers/image.worker.ts",
    "worker:email": "tsx --env-file=.env src/workers/email.worker.ts",
    "worker:cleanup": "tsx --env-file=.env src/workers/cleanup.worker.ts",
    "worker:payout": "tsx --env-file=.env src/workers/payout.worker.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts --pool=forks",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --reporter=verbose --coverage",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate": "prisma migrate dev --config prisma.config.ts",
    "db:migrate:prod": "prisma migrate deploy --config prisma.config.ts",
    "db:push": "prisma db push --config prisma.config.ts",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --config prisma.config.ts",
    "db:studio": "prisma studio --config prisma.config.ts",
    "infra:up": "docker compose -f docker-compose.infra.yml up -d",
    "infra:down": "docker compose -f docker-compose.infra.yml down",
    "infra:logs": "docker compose -f docker-compose.infra.yml logs -f",
    "infra:clean": "docker compose -f docker-compose.infra.yml down -v",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose up --build",
    "docker:prod:down": "docker compose down",
    "docker:clean": "docker compose down -v && docker system prune -f",
    "stripe": "stripe listen --forward-to localhost:3000/api/v1/payments/webhook",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rimraf dist",
    "prebuild": "pnpm clean && pnpm typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@testcontainers/postgresql": "^11.13.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.2.1",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/zxcvbn": "^4.4.5",
    "@vitest/coverage-v8": "^4.1.2",
    "pino-pretty": "^13.1.3",
    "prisma": "7.3.0",
    "prisma-mock": "^1.1.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "testcontainers": "^11.13.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "vitest-mock-extended": "^3.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1028.0",
    "@faker-js/faker": "^10.4.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.3.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.3",
    "compression": "^1.8.1",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "jose": "^6.1.3",
    "libphonenumber-js": "^1.12.36",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.19.0",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "sharp": "^0.34.5",
    "stripe": "^20.4.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xss": "^1.0.15",
    "zod": "^4.3.6",
    "zxcvbn": "^4.4.2"
  },
  "pnpm": {
    "overrides": {
      "ioredis": "5.10.0"
    }
  }
}
