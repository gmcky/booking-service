    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "envalid": "^8.1.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.1.3",
    "libphonenumber-js": "^1.12.36",
    "pino": "^10.3.0",
    "pino-http": "^11.0.0",
    "redis": "^5.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  }
