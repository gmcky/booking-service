# pnpm configuration

# Use strict peer dependencies
strict-peer-dependencies=false

# Auto install peers
auto-install-peers=true

# Shamefully hoist (for better compatibility)
# Set to false for stricter dependency management
shamefully-hoist=false

# Store dir (optional, uncomment to set custom location)
# store-dir=~/.pnpm-store

# Lockfile settings
lockfile=true

# Public hoist pattern (for tools that need global access)
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=@types*
