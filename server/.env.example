# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (Docker: use service name "postgres"; local: use "localhost")
DB_USER=booking_user
DB_PASSWORD=booking_password
DB_NAME=booking_db
DATABASE_URL=postgresql://booking_user:booking_password@localhost:5432/booking_db

# Redis (Docker: use service name "redis"; local: use "localhost")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# AWS S3 (avatars, property images)
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# CORS (set to frontend URL in production)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# API Documentation
SWAGGER_ENABLED=true

# Sentry (optional — leave empty to disable)
SENTRY_DSN=
