# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database (Docker: use service name "postgres"; local: use "localhost")
DB_USER=booking_user
DB_PASSWORD=booking_password
DB_NAME=booking_db
DATABASE_URL=postgresql://booking_user:booking_password@localhost:5432/booking_db

# Redis (Docker: use service name "redis"; local: use "localhost")
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# S3-compatible object storage (avatars, property images) — AWS S3 or Cloudflare R2
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 only — leave both empty for plain AWS S3. Use AWS_REGION=auto with R2.
S3_ENDPOINT=
S3_PUBLIC_URL=

# CORS (set to frontend URL in production)
CORS_ORIGIN=http://localhost:3000

# Frontend base URL — used to build links in emails (e.g. verify-email)
CLIENT_URL=http://localhost:3001

# Rate limiting — global READ ceiling (map browse fires 2 requests per pan,
# keep generous; auth/write endpoints have separate stricter limiters)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=info
LOG_PRETTY_PRINT=true

# API Documentation
SWAGGER_ENABLED=true

# Sentry (optional — leave empty to disable)
SENTRY_DSN=

# Demo cleanup cron — wipes non-origin user data daily on the live demo.
# Flip to false and restart workers to drop the schedule.
DEMO_CLEANUP_ENABLED=false
DEMO_CLEANUP_CRON=0 3 * * *

# Geocoding (Nominatim; defaults work — set a contactable User-Agent per
# https://operations.osmfoundation.org/policies/nominatim/)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=gmck-booking-portfolio/1.0 (booking.gmcky.dev)
